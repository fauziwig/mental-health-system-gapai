# Supabase Connection
# Gunakan connection string PostgreSQL dari Supabase Settings > Database > Connection String (URI / Session / Transaction Pooler)
# Format: postgres://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:password@localhost:5432/mental_health_db

# Supabase Public API (Optional for direct client auth/storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
